RGB402_BIND_ADDR=127.0.0.1:3000
RGB402_MERCHANT_URL=http://127.0.0.1:3000
RGB402_SIM_LEDGER_PATH=.rgb402-sim-ledger.json

# Legacy simulated-demo configuration; the real wallet does not use Polar.
RGB402_LIGHTNING_BACKEND=polar
POLAR_RGB_LIGHTNING_ENDPOINT=http://127.0.0.1:3001


# Managed demo: run ./scripts/regtest/demo.sh, then source .var/regtest/wallet.env.
# Values below are for an independently managed compatible regtest node.
RGB_NODE_URL=http://127.0.0.1:3001
# Biscuit bearer token when node authentication is enabled; never give it to an LLM.
RGB_NODE_TOKEN=
# Replace with your issued NIA demo asset ID. This placeholder is not spendable.
ALLOWED_ASSET_IDS=rgb:replace-with-demo-asset-id
# Integer asset BASE units, per asset. For precision 2: 100 means 1.00.
AUTO_APPROVE_BELOW=100
MAX_SINGLE_PAYMENT=1000
MAX_DAILY_SPEND=5000
# Bitcoin carrier invoice amount in millisatoshis; routing fees are node-managed.
MAX_CARRIER_MSAT=3000000
WALLET_STATE_PATH=.wallet-state.json
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-terra
